APP_NAME=MelbHack Accessibility API
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://melbhack:melbhack@localhost:55432/melbhack
CORS_ORIGINS=["http://localhost:5173"]
PAIRING_CODE_SECRET=replace-with-at-least-32-random-characters
MAX_REQUEST_BYTES=20971520
PDF_RENDER_TIMEOUT_SECONDS=20
PDF_RENDER_CONCURRENCY=2
GEMINI_API_KEY=replace-with-your-google-ai-api-key
GEMINI_MODEL=gemini-3.6-flash
AI_REQUEST_TIMEOUT_SECONDS=30
AI_REQUEST_CONCURRENCY=2
AI_CAPACITY_WAIT_SECONDS=2
AI_REQUESTS_PER_MINUTE=15
AI_REQUESTS_PER_IP_PER_MINUTE=15
AI_GLOBAL_REQUESTS_PER_MINUTE=15
