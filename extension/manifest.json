{
  "manifest_version": 3,
  "name": "AI Accessible Screen Reader & Web Restyler",
  "version": "1.0.0",
  "description": "Real-time dyslexia-friendly typography, high-contrast restyling, and a keyboard-driven screen reader with synchronized highlighting.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://hackmelbourne2026-production.up.railway.app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/restyler.js",
        "content/bionic-reader.js",
        "content/custom-cursor.js",
        "content/screen-reader.js",
        "content/extractor.js",
        "content/panel.js",
        "content/toolbar.js",
        "content/content.js"
      ],
      "css": [
        "hud/hud.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*",
        "styles/*",
        "hud/*",
        "icons/*",
        "sidebar/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "toggle-read": {
      "suggested_key": {
        "default": "Alt+R"
      },
      "description": "Start/stop reading from current position"
    },
    "next-element": {
      "suggested_key": {
        "default": "Alt+N"
      },
      "description": "Jump to next readable element"
    },
    "prev-element": {
      "suggested_key": {
        "default": "Alt+P"
      },
      "description": "Jump to previous readable element"
    }
  }
}